########################################################################
#                                                                      #
#      cpw.in input file generated by hand                             #
#                                                                      #
########################################################################

SystemLabel                       Pa3 Hydrogen


#------------------------------------------------
# Crystal structure
#------------------------------------------------

LatticeConstant               11.06600000     bohr

%block LatticeVectors
         1.00000000         0.00000000         0.00000000
         0.00000000         1.00000000         0.00000000
         0.00000000         0.00000000         1.00000000
%endblock LatticeVectors

NumberOfSpecies                1

NumberOfAtoms                8

%block Chemical_Species_Label
     1       7    N
%endblock Chemical_Species_Label

AtomicCoordinatesFormat     Fractional

%block AtomicCoordinatesAndAtomicSpecies
         0.05490000      0.05490000      0.05490000        1     #   N       1
        -0.05490000     -0.05490000     -0.05490000        1     #   N       2
         0.05490000      0.44510000      0.55490000        1     #   N       3
        -0.05490000     -0.44510000     -0.55490000        1     #   N       4
         0.55490000      0.05490000      0.44510000        1     #   N       5
        -0.55490000     -0.05490000     -0.44510000        1     #   N       6
         0.44510000      0.55490000      0.05490000        1     #   N       7
        -0.44510000     -0.55490000     -0.05490000        1     #   N       8
%endblock AtomicCoordinatesAndAtomicSpecies

StructureSource               experiment

#------------------------------------------------
# Energy cutoff, bands,  and Brillouin mesh
#------------------------------------------------

PWEnergyCutoff                  80.0000      hartree

NumberOfEigenStates                  30

%block kgrid_Monkhorst_Pack
               2       0       0       0.500000
               0       2       0       0.500000
               0       0       2       0.500000
%endblock kgrid_Monkhorst_Pack


#------------------------------------------------
# Active options
#------------------------------------------------

MD.TypeOfRun                  ONE           # ONE,EPILBF,MICRO,LANG,LBFSYM,VCSLNG,VCSLBF,RSTRT

UseSymmetry                   .true.        # .true. , .false.

MD.UseKeatingCorrections      .false.       # .true. , .false.

MD.UseFixedkplusG             .true.        # .true. , .false.

TypeOfScfDiag                 PW            # PW,AO,AOJC,AOJCPW

DualApproximation             .false.       #  .true. , .false.

XC.Authors                    CA            # CA, PBE, TBL

Xc.TBL.C                      1.04          # sets Tran-Blaha constant (if negative use calculated)

PrintingLevel                 2             # 1, 2, 3


